{
  "$ref": "#/definitions/read-request",
  "definitions": {
    "read-request": {
      "type": "object",
      "properties": {
        "layoutSpec": {
          "type": "object",
          "properties": {
            "specVersion": {
              "type": "number",
              "const": 1
            },
            "instrumentId": {
              "type": "string",
              "format": "uuid"
            },
            "pageCount": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "paper": {
              "type": "string",
              "enum": [
                "letter",
                "a4",
                "legal"
              ]
            },
            "fiducials": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "corner_squares"
                },
                "sizeRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "marginRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "kind",
                "sizeRatio",
                "marginRatio"
              ],
              "additionalProperties": false
            },
            "identity": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "qr",
                    "rut_bubbles",
                    "none"
                  ]
                },
                "region": {
                  "type": "object",
                  "properties": {
                    "topLeft": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "bottomRight": {
                      "$ref": "#/definitions/read-request/properties/layoutSpec/properties/identity/properties/region/properties/topLeft"
                    }
                  },
                  "required": [
                    "topLeft",
                    "bottomRight"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "mode",
                "region"
              ],
              "additionalProperties": false
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fieldId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "bubble_group",
                      "digit_grid",
                      "crop_region"
                    ]
                  },
                  "printedNumber": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pageIndex": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "selectMode": {
                    "type": "string",
                    "enum": [
                      "single",
                      "multiple"
                    ]
                  },
                  "bubbles": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "center": {
                          "$ref": "#/definitions/read-request/properties/layoutSpec/properties/identity/properties/region/properties/topLeft"
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "value",
                        "center",
                        "radius"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "region": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/read-request/properties/layoutSpec/properties/identity/properties/region"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "fieldId",
                  "kind",
                  "printedNumber",
                  "pageIndex",
                  "selectMode",
                  "bubbles",
                  "region"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "specVersion",
            "instrumentId",
            "pageCount",
            "paper",
            "fiducials",
            "identity",
            "fields"
          ],
          "additionalProperties": false
        },
        "captureProfile": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "scanner",
                "phone"
              ]
            },
            "normalizeIllumination": {
              "type": "boolean"
            },
            "minSharpness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxGlare": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "expectedDpi": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "source",
            "normalizeIllumination",
            "minSharpness",
            "maxGlare",
            "expectedDpi"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "pdf",
                "images"
              ]
            },
            "pdfUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "imageUrls": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "pdfUrl",
            "imageUrls"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "layoutSpec",
        "captureProfile",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
